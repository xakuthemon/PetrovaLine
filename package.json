{
  "name": "terrawaltz",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "TerraWaltz — Dancing with the SARs. An interactive NISAR mission experience with simulated scenes.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single && node tools/make-embed.mjs --release",
    "build:embed": "vite build --mode embed && node tools/make-embed.mjs --embed",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource/instrument-serif": "^5.2.5",
    "lucide-react": "0.469.0",
    "motion": "^12.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.149.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "0.149.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.3",
    "vite": "^6.4.6",
    "vite-plugin-singlefile": "2.2.0"
  }
}
